{
  "name": "initiative",
  "version": "0.1.0",
  "private": true,
  "description": "A planning playing game: your work as monsters and your team as heroes on a tabletop map.",
  "keywords": [
    "planning",
    "tabletop",
    "rpg",
    "svg",
    "nextjs",
    "local-first"
  ],
  "homepage": "https://initiative-ppg.vercel.app",
  "bugs": "https://github.com/WojtekTheWebDev/initiative/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WojtekTheWebDev/initiative.git"
  },
  "license": "MIT",
  "author": {
    "name": "Wojciech Sikora",
    "url": "https://www.wojciechsikora.dev/"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:felt": "node scripts/make-felt.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "bake:minis": "playwright install --only-shell chromium && tsx scripts/bake-minis.ts",
    "bake:terrain": "npm run bake:minis -- --src assets/terrain --out public/terrain"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
